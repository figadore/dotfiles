[user]
	email = 3253971+figadore@users.noreply.github.com
	name = Reese Wilson
	signingkey = 1213950597C8826C567DAFCFFDEBB971AD3CDB77
[push]
	default = current
[core]
	excludesfile = ~/.gitignore_global
[color]
	ui = true
#[credential]
#	helper = !aws --profile tools-dev codecommit credential-helper $@
#	UseHttpPath = true
[alias]
	aa = "add -u ."
	a = "add"
	d = diff
	c = commit
	ca = "commit --amend"
	co = checkout
	cm = "commit -m"
	p = "push"
	s = "status"
	branch-clean = "! git branch -l --merged | xargs git branch -d"
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[oh-my-zsh]
	hide-status = 1
	hide-status = 1
	hide-dirty = 1
[pull]
	ff = only
[init]
	defaultBranch = main
[commit]
	gpgsign = true
#[url "git@github.com:"]
#  insteadOf = https://github.com/
# insteadOf for ssh replacement lives in ~/.gitconfig-hostonly
# This helps codespaces and devcontainers use their http github auth instead of ssh keys
[include]
	path = /Users/r631269@regence.com/.gitconfig-hostonly
